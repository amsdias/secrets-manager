<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="PowerShell Secrets"
           Manufacturer="secrets-manager (github.com/amsdias/secrets-manager)"
           Version="$(Version)"
           UpgradeCode="7b3f2d4e-5a61-4c8e-9f0d-2e6b1a9c4d73"
           Scope="perUser"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of PowerShell Secrets is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(RepoRoot)src\SecretsManager.App\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/amsdias/secrets-manager" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="SecretsManager" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Per-user components need an HKCU key path (ICE38) and must remove the folders they create (ICE64). -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="App" Guid="3c9a6e21-8f4b-4d7a-b5e2-91d0c6f3a8b4">
        <File Id="AppExe" Source="$(PublishDir)SecretsManager.exe" />
        <File Id="CliExe" Source="$(PublishDir)secrets.exe" />
        <!-- "secrets get name" in any new terminal. Windows joins the user and system PATH (unlike PSModulePath), and
             uninstalling removes only this entry. -->
        <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" Permanent="no" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SecretsManager" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="AppShortcut" Name="PowerShell Secrets" Description="Manage PowerShell SecretManagement vaults and secrets"
                  Target="[INSTALLFOLDER]SecretsManager.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\SecretsManager" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>

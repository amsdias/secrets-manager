<Project Sdk="WixToolset.Sdk/6.0.2">
  <!--
    Per-user MSI (no admin rights): SecretsManager.exe + secrets.exe (added to the user PATH) from a publish folder, a Start menu shortcut,
    an entry in Settings > Apps, and in-place upgrades. Uninstalling never touches %LOCALAPPDATA%\SecretsManager (settings,
    bundled modules, Windows-account vaults) or SecretStore.

      dotnet build installer/SecretsManager.Installer.wixproj -c Release -p:Version=1.2.3 -p:PublishDir=<folder with both exes>\

    Not MSIX on purpose: a packaged app's writes under %LOCALAPPDATA% are redirected to a private folder, so the app would
    use a different SecretStore than PowerShell and secrets.exe.
  -->
  <PropertyGroup>
    <OutputName>PowerShellSecrets</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- ICE91: "per-user folder doesn't vary with ALLUSERS". Intended: this package is per-user only. -->
    <SuppressIces>ICE91</SuppressIces>
    <Version Condition="'$(Version)' == ''">0.0.1</Version>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\publish\</PublishDir>
    <DefineConstants>Version=$(Version);PublishDir=$(PublishDir);RepoRoot=$(MSBuildThisFileDirectory)..\</DefineConstants>
  </PropertyGroup>
</Project>

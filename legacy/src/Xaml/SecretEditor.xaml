<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI" FontSize="13" Background="#F9FAFB" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Secret" Width="540" Height="620" MinWidth="420" MinHeight="480" ResizeMode="CanResizeWithGrip">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button x:Name="SaveButton" Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
        <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,0,6"/>
      </StackPanel>
    </StackPanel>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="120"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="90"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
      <TextBox x:Name="NameBox" Grid.Row="1"/>
      <TextBlock Grid.Row="2" Text="Type" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="TypeCombo" Grid.Row="3"/>
      <TextBlock Grid.Row="4" x:Name="ValueLabel" Text="Value" Style="{StaticResource FieldLabel}"/>
      <Grid Grid.Row="5">
        <TextBox x:Name="StringBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" FontFamily="Consolas"/>
        <StackPanel x:Name="SecurePanel">
          <Grid>
            <PasswordBox x:Name="SecureBox" FontFamily="Consolas"/>
            <TextBox x:Name="SecureReveal" FontFamily="Consolas" Visibility="Collapsed"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox x:Name="SecureShowCheck" Content="Show" VerticalAlignment="Center" Margin="0,0,14,6"/>
            <Button x:Name="SecureGenerateButton" Content="Generate" ToolTip="Fill with a random 24-character password"/>
          </StackPanel>
          <TextBlock Style="{StaticResource HintText}" Text="Stored as a SecureString. Get-Secret returns it as [securestring] unless -AsPlainText is used."/>
        </StackPanel>
        <StackPanel x:Name="CredPanel">
          <TextBlock Text="User name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
          <TextBox x:Name="UserBox"/>
          <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
          <Grid>
            <PasswordBox x:Name="CredBox" FontFamily="Consolas"/>
            <TextBox x:Name="CredReveal" FontFamily="Consolas" Visibility="Collapsed"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox x:Name="CredShowCheck" Content="Show" VerticalAlignment="Center" Margin="0,0,14,6"/>
            <Button x:Name="CredGenerateButton" Content="Generate" ToolTip="Fill with a random 24-character password"/>
          </StackPanel>
        </StackPanel>
        <DockPanel x:Name="HashPanel">
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,4" Text="One key=value per line. Values are stored as strings."/>
          <TextBox x:Name="HashBox" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas"/>
        </DockPanel>
        <DockPanel x:Name="BytesPanel">
          <DockPanel DockPanel.Dock="Top">
            <Button x:Name="LoadFileButton" Content="Load file…" DockPanel.Dock="Left"/>
            <TextBlock x:Name="BytesInfo" VerticalAlignment="Center" Margin="6,0,0,6" Style="{StaticResource HintText}" Text="Base64 content, or load a file (max 1 MB)."/>
          </DockPanel>
          <TextBox x:Name="BytesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="11.5"/>
        </DockPanel>
      </Grid>
      <TextBlock Grid.Row="6" Text="Metadata (optional, key=value per line, not encrypted)" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="MetadataBox" Grid.Row="7" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
               VerticalContentAlignment="Top" FontFamily="Consolas"/>
    </Grid>
  </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI" FontSize="13" Background="#F9FAFB" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Secret" Width="540" Height="440" MinWidth="400" MinHeight="300" ResizeMode="CanResizeWithGrip">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="InfoText" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
      <TextBlock x:Name="MetaText" Style="{StaticResource HintText}" FontFamily="Consolas" Margin="0,6,0,0"/>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <CheckBox x:Name="RevealCheck" Content="Reveal value" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,0,6"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CopyUserButton" Content="Copy user name" Visibility="Collapsed"/>
        <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource PrimaryButton}"/>
        <Button x:Name="SaveFileButton" Content="Save to file…" Visibility="Collapsed"/>
        <Button x:Name="CloseButton" Content="Close" IsCancel="True" Margin="0,0,0,6"/>
      </StackPanel>
    </DockPanel>
    <TextBox x:Name="ValueBox" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Background="#FFFFFF"/>
  </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI" FontSize="13" Background="#F9FAFB" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Register vault" Width="500" SizeToContent="Height" ResizeMode="NoResize">
  <StackPanel Margin="18">
    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
    <TextBox x:Name="NameBox"/>
    <TextBlock Text="Extension module" Style="{StaticResource FieldLabel}"/>
    <ComboBox x:Name="ModuleCombo" IsEditable="True"/>
    <TextBlock x:Name="ModuleHint" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
    <TextBlock Text="Description (optional)" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="DescriptionBox"/>
    <TextBlock Text="Vault parameters (optional, key=value per line)" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="ParametersBox" AcceptsReturn="True" Height="70" VerticalContentAlignment="Top" FontFamily="Consolas"
             VerticalScrollBarVisibility="Auto"/>
    <CheckBox x:Name="DefaultCheck" Content="Make this the default vault" Margin="0,12,0,0"/>
    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="OkButton" Content="Register" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,0,6"/>
    </StackPanel>
  </StackPanel>
</Window>

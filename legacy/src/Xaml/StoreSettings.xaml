<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI" FontSize="13" Background="#F9FAFB" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="SecretStore settings" Width="500" SizeToContent="Height" ResizeMode="NoResize">
  <StackPanel Margin="18">
    <TextBlock Text="Settings for Microsoft.PowerShell.SecretStore (CurrentUser scope). They apply to every vault that uses SecretStore."
               TextWrapping="Wrap"/>
    <TextBlock x:Name="PathText" Style="{StaticResource HintText}" FontFamily="Consolas" Margin="0,6,0,0"/>
    <TextBlock Text="Authentication" Style="{StaticResource FieldLabel}"/>
    <ComboBox x:Name="AuthCombo"/>
    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
               Text="Password: the store is encrypted with your password. None: it is protected only by your Windows account."/>
    <TextBlock Text="Password timeout (seconds)" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="TimeoutBox"/>
    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" Text="How long the store stays unlocked after a password is entered."/>
    <TextBlock Text="Interaction" Style="{StaticResource FieldLabel}"/>
    <ComboBox x:Name="InteractionCombo"/>
    <TextBlock x:Name="InteractionHint" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"/>
    <DockPanel Margin="0,18,0,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button x:Name="ChangePasswordButton" Content="Change password…"/>
        <Button x:Name="ResetButton" Content="Reset store…" Style="{StaticResource DangerButton}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SaveButton" Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
        <Button x:Name="CancelButton" Content="Close" IsCancel="True" Margin="0,0,0,6"/>
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>

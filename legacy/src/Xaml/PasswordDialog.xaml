<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI" FontSize="13" Background="#F9FAFB" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Password" Width="420" SizeToContent="Height" ResizeMode="NoResize">
  <StackPanel Margin="18">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
    <StackPanel x:Name="CurrentPanel" Visibility="Collapsed">
      <TextBlock Text="Current password" Style="{StaticResource FieldLabel}"/>
      <PasswordBox x:Name="CurrentBox"/>
    </StackPanel>
    <StackPanel x:Name="NewPanel">
      <TextBlock x:Name="PasswordLabel" Text="Password" Style="{StaticResource FieldLabel}"/>
      <PasswordBox x:Name="PasswordBox1"/>
    </StackPanel>
    <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
      <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}"/>
      <PasswordBox x:Name="PasswordBox2"/>
    </StackPanel>
    <CheckBox x:Name="OptionCheck" Visibility="Collapsed" Margin="0,12,0,0">
      <TextBlock x:Name="OptionText" TextWrapping="Wrap"/>
    </CheckBox>
    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="OkButton" Content="OK" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,0,6"/>
    </StackPanel>
  </StackPanel>
</Window>

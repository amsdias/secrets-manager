<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI" FontSize="13" Background="#F9FAFB" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Input" Width="420" SizeToContent="Height" ResizeMode="NoResize">
  <StackPanel Margin="18">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBox x:Name="InputBox"/>
    <ComboBox x:Name="InputCombo" Visibility="Collapsed"/>
    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="OkButton" Content="OK" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,0,6"/>
    </StackPanel>
  </StackPanel>
</Window>

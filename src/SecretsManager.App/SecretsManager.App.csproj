<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And ('$(Platform)' == '' Or '$(Platform)' == 'AnyCPU')">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <RootNamespace>SecretsManager.App</RootNamespace>
    <AssemblyName>SecretsManager</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.18" />
  </ItemGroup>
  <!--
    A RID-specific (self-contained) publish puts System.Management.Automation.dll in the publish root, so the
    hosted PowerShell's $PSHOME is that folder and it looks for its built-in modules (Microsoft.PowerShell.Management,
    .Utility, .Security …) in $PSHOME\Modules. The PowerShell SDK package leaves them under runtimes\win\lib\<tfm>\Modules,
    so copy them next to the DLL. Without this, commands like Resolve-Path (used by Register-SecretVault) fail.
  -->
  <Target Name="CopyPowerShellBuiltInModulesToPublishRoot" AfterTargets="Publish">
    <PropertyGroup>
      <PwshModulesSource>$(PublishDir)runtimes\win\lib\$(TargetFramework.Split('-')[0])\Modules\</PwshModulesSource>
    </PropertyGroup>
    <ItemGroup>
      <!-- %(RecursiveDir) is relative to the first wildcard, i.e. <ModuleName>\..., so files land in Modules\<ModuleName>\ -->
      <PwshBuiltInModule Include="$(PwshModulesSource)**\*" />
    </ItemGroup>
    <Error Condition="'@(PwshBuiltInModule)' == ''" Text="PowerShell built-in modules not found at $(PwshModulesSource)" />
    <Copy SourceFiles="@(PwshBuiltInModule)"
          DestinationFiles="@(PwshBuiltInModule->'$(PublishDir)Modules\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\SecretsManager.Core\SecretsManager.Core.csproj" />
  </ItemGroup>
</Project>

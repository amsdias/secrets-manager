<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And ('$(Platform)' == '' Or '$(Platform)' == 'AnyCPU')">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <RootNamespace>SecretsManager.App</RootNamespace>
    <AssemblyName>SecretsManager</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Windows App SDK needs this to embed resources.pri in a single-file exe. -->
    <EnableMsixTooling Condition="'$(PublishSingleFile)' == 'true'">true</EnableMsixTooling>
    <!-- Self-contained single file: compress the bundle (232 MB -> 88 MB). Not available for framework-dependent builds. -->
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true' And '$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also loaded at runtime for the window and taskbar icon (tools/New-AppIcon.ps1 draws it). -->
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
    <!-- The Windows-account vault module, installed to %LOCALAPPDATA%\SecretsManager\Modules at startup (WindowsVaultModule). -->
    <EmbeddedResource Include="..\WindowsVault\**\*" LogicalName="WindowsVault\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.18" />
  </ItemGroup>
  <!--
    A RID-specific publish puts System.Management.Automation.dll in the publish root, so the hosted PowerShell's $PSHOME is
    that folder (or, in a single-file build, the folder the bundle extracts to) and it looks for its built-in modules
    (Microsoft.PowerShell.Management, .Utility, .Security …) in $PSHOME\Modules. The PowerShell SDK package publishes them under
    runtimes\win\lib\<tfm>\Modules, so move them to Modules\ in the publish list, before single-file bundling.
    Without this, Register-SecretVault (Resolve-Path) fails when the app is started from Explorer.
  -->
  <Target Name="PublishPowerShellBuiltInModulesAtRoot" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_PwshModuleFile Include="@(ResolvedFileToPublish)"
                       Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('/', '\').StartsWith('runtimes\win\lib\')) And $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('/', '\').Contains('\Modules\'))" />
      <_PwshModuleFile>
        <RelativePath>$([System.String]::Copy('%(RelativePath)').Replace('/', '\').Substring($([System.String]::Copy('%(RelativePath)').Replace('/', '\').IndexOf('\Modules\'))).TrimStart('\'))</RelativePath>
      </_PwshModuleFile>
      <ResolvedFileToPublish Remove="@(_PwshModuleFile)" />
      <ResolvedFileToPublish Include="@(_PwshModuleFile)" />
    </ItemGroup>
    <Error Condition="'@(_PwshModuleFile)' == ''" Text="PowerShell built-in modules not found in the publish list (runtimes\win\lib\*\Modules)." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\SecretsManager.Core\SecretsManager.Core.csproj" />
  </ItemGroup>
</Project>

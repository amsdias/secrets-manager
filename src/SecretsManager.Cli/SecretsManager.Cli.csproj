<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Console front end for "SecretsManager.exe get". SecretsManager.exe is a GUI-subsystem app, and PowerShell starts GUI
    apps without waiting or capturing their output, so "$x = SecretsManager.exe get name" would come back empty.
    This console exe starts it with redirected pipes and relays its output and exit code.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>SecretsManager.Cli</AssemblyName>
    <RootNamespace>SecretsManager.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Native code: a ~1-2 MB exe that needs no .NET installed (it only starts a process and copies its output). -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
